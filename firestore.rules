rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Security baseline
    // -------------------------------------------------------------------------
    // Client-side Firestore writes are intentionally disabled while the
    // application migrates to authenticated server-side business operations.
    // Sensitive collections must NEVER be writable from an untrusted browser.
    //
    // Public reads are limited to storefront-safe catalog content.
    // All other reads/writes require an authenticated backend path and are
    // denied here until explicit tenant/branch/RBAC rules are implemented.
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny: every collection not explicitly listed below is private.
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Public storefront data
    // -------------------------------------------------------------------------
    // These collections contain catalog/display data only. Do not place
    // secrets, internal cost data, customer data, or operational credentials
    // in them.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Sensitive/business collections
    // -------------------------------------------------------------------------
    // Writes are blocked from browsers. Reads are also blocked until the
    // server-side authentication + tenant/branch/RBAC model is in place.
    match /customers/{customerId} {
      allow read, write: if false;
    }

    match /staff/{staffId} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    match /coupons/{couponId} {
      allow read, write: if false;
    }

    match /monime_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /test/{testId} {
      allow read, write: if false;
    }
  }
}
